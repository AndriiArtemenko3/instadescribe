#!/usr/bin/env bash
set -euo pipefail

printf 'curl %s\n' "$*" >>"$MOCK_COMMAND_LOG"

count=0
if [[ -f "$MOCK_CURL_COUNT_FILE" ]]; then
  count="$(<"$MOCK_CURL_COUNT_FILE")"
fi
count=$((count + 1))
printf '%s\n' "$count" >"$MOCK_CURL_COUNT_FILE"

case "${MOCK_SCENARIO:-readiness_success}" in
  readiness_delayed)
    (( count >= 3 ))
    ;;
  readiness_timeout)
    exit 22
    ;;
  *)
    exit 0
    ;;
esac
