#!/usr/bin/env bash
set -euo pipefail

printf 'aws %s\n' "$*" >>"$MOCK_COMMAND_LOG"

case "$1 $2" in
  "sts get-caller-identity")
    if [[ "${MOCK_SCENARIO:-success}" == "wrong_account" ]]; then
      wrong_account="$(printf '2%.0s' {1..12})"
      printf '{"Account":"%s","Arn":"arn:aws:iam::%s:user/mock","UserId":"mock"}\n' "$wrong_account" "$wrong_account"
    else
      printf '{"Account":"%s","Arn":"arn:aws:iam::%s:user/mock","UserId":"mock"}\n' "$MOCK_EXPECTED_ACCOUNT_ID" "$MOCK_EXPECTED_ACCOUNT_ID"
    fi
    ;;
  "ecs run-task")
    case "${MOCK_SCENARIO:-success}" in
      run_task_command_failure)
        exit 13
        ;;
      run_task_failures)
        printf '%s\n' '{"failures":[{"arn":"mock","reason":"capacity"}],"tasks":[]}'
        ;;
      empty_tasks)
        printf '%s\n' '{"failures":[],"tasks":[]}'
        ;;
      none_arn)
        printf '%s\n' '{"failures":[],"tasks":[{"taskArn":"None"}]}'
        ;;
      *)
        printf '{"failures":[],"tasks":[{"taskArn":"arn:aws:ecs:eu-west-2:%s:task/mock-task"}]}\n' "$MOCK_EXPECTED_ACCOUNT_ID"
        ;;
    esac
    ;;
  "ecs wait")
    if [[ "$3" == "services-stable" && "${MOCK_SCENARIO:-success}" == "service_wait_failure" ]]; then
      exit 12
    fi
    ;;
  "ecs describe-tasks")
    case "${MOCK_SCENARIO:-success}" in
      missing_exit)
        printf '%s\n' '{"failures":[],"tasks":[{"lastStatus":"STOPPED","desiredStatus":"STOPPED","containers":[{"name":"migration","lastStatus":"STOPPED"}]}]}'
        ;;
      nonzero_exit)
        printf '%s\n' '{"failures":[],"tasks":[{"lastStatus":"STOPPED","desiredStatus":"STOPPED","containers":[{"name":"migration","lastStatus":"STOPPED","exitCode":1}]}]}'
        ;;
      unexpected_state)
        printf '%s\n' '{"failures":[],"tasks":[{"lastStatus":"RUNNING","desiredStatus":"STOPPED","containers":[{"name":"migration","lastStatus":"RUNNING","exitCode":0}]}]}'
        ;;
      *)
        printf '%s\n' '{"failures":[],"tasks":[{"lastStatus":"STOPPED","desiredStatus":"STOPPED","containers":[{"name":"migration","lastStatus":"STOPPED","exitCode":0}]}]}'
        ;;
    esac
    ;;
  "logs tail")
    printf '%s\n' '2026-08-08T00:00:00Z migration head check complete'
    ;;
  *)
    printf 'unexpected aws mock command: %s\n' "$*" >&2
    exit 92
    ;;
esac
