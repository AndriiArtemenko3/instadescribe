# Explicit cloud mode for the FastAPI cloud-core integration (G7).
# Non-secret build flag only — the portfolio token is NEVER placed in a
# Vite variable; it is entered at runtime and kept in sessionStorage.
# In dev the API origin defaults to http://localhost:8000; a production
# cloud build keeps VITE_API_BASE explicitly empty for same-origin /api/*.
VITE_CLOUD_MODE=1
