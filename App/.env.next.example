# Server-only Next BFF configuration. Never prefix these with NEXT_PUBLIC_.
AWS_REGION=eu-west-2
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_APP_CLIENT_SECRET=
WEB_SESSION_TABLE_NAME=
WEB_SESSION_KMS_KEY_ID=
# Base64url-encoded random value containing at least 32 bytes.
WEB_SESSION_HMAC_SECRET=
# Canonical base64url (no padding) for exactly 32 independent random bytes.
BROWSER_ASSERTION_SECRET=
APP_API_ORIGIN=https://api.example.com
APP_ORIGIN=https://app.instadescribe.com

# Optional bounded overrides.
WEB_SESSION_TTL_SECONDS=2592000
AUTH_CHALLENGE_TTL_SECONDS=600
ACCESS_TOKEN_REFRESH_SKEW_SECONDS=60
